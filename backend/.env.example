APP_NAME=CodeLingo
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# DB_DATABASE: ruta absoluta a tu SQLite; si se omite usa database/database.sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_COOKIE=codelingo_session
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
